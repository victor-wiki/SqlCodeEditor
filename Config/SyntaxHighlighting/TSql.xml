<?xml version="1.0"?>
<SyntaxDefinition name = "TSql"
                  extensions = ".sql">
	<Properties>
		<Property name="LineComment"
				  value="--"/>
	</Properties>
	<Digits name = "Digits"
			bold = "true"
			italic = "false"
			color = "Blue"/>
